# ===== Tome =====

# Base URL da instancia Tome (sem barra no final)
TOME_URL=http://localhost:8080

# Token de API: Settings -> API tokens (formato tome_...)
# IMPORTANTE: precisa ter permissao de admin para marcar as wishes como fulfilled.
TOME_API_TOKEN=tome_sua_chave_aqui

# Intervalo de checagem da wishlist, em SEGUNDOS.
# Ex.: 60 = 1 minuto | 3600 = 1 hora
TOME_POLL_INTERVAL=60

# Status da wishlist a processar: open | fulfilled | dismissed
TOME_WISHLIST_STATUS=open

# Tipo de livro criado/usado no Tome para os uploads vindos da wishlist
TOME_BOOK_TYPE_SLUG=wishlist-imported
TOME_BOOK_TYPE_LABEL=Wishlist

# Retry do upload: nova tentativa a cada N segundos, ate N tentativas
TOME_UPLOAD_RETRY_INTERVAL=60
TOME_UPLOAD_MAX_RETRIES=3

# ===== Z-Library =====

# Espelho/instancia Z-Library preferido (sem barra no final). Se estiver atras de um
# bot check (DiamWall/Cloudflare), o programa automaticamente descobre outro mirror.
ZLIB_BASE_URL=https://article.sk

# Espelhos adicionais candidatos, separados por virgula (opcional). Se vazio, o programa
# usa uma lista embutida + a lista dinamica baixada do servidor de dominios.
ZLIB_MIRRORS=

# Credenciais da conta Z-Library
ZLIB_EMAIL=seu_email@exemplo.com
ZLIB_PASSWORD=sua_senha

# Idiomas da busca, separados por virgula (chaves do API: portuguese, brazilian, english, ...)
ZLIB_LANGUAGES=portuguese,english

# Ordenacao dos resultados: popular | bestmatch | date | titleA | title | year | filesize | filesizeA
ZLIB_ORDER=bestmatch

# Ranking de formato preferido, do melhor para o pior (1o vence).
# Na ausencia de um formato melhor, os ultimos da lista (cbz/cbr) podem ser usados,
# mas nunca tem prioridade sobre epub/mobi/azw3/pdf.
ZLIB_FORMAT_PREFERENCE=epub,mobi,azw3,pdf,cbz,cbr

# Diretorio temporario dos downloads (o arquivo e apagado apos upload com sucesso no Tome)
ZLIB_DOWNLOAD_DIR=./downloads

# Quantos livros baixar por ciclo
ZLIB_MAX_DOWNLOADS_PER_RUN=1
